{
  "manifest_version": 3,
  "name": "Lane Guard",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Per-tab environment isolation for AI browser automation.",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*", "https://app.example.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "control.html"},
  "declarative_net_request": {
    "rule_resources": [{"id": "default_deny", "enabled": true, "path": "deny.json"}]
  },
  "web_accessible_resources": [{
    "resources": ["gate.html", "gate.js"],
    "matches": ["http://127.0.0.1/*"]
  }]
}
